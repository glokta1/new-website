---
import { getImage } from "astro:assets";
import profileImg from "../assets/profile.jpeg";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import MediaLightbox from "../components/MediaLightbox.astro";
import "../globals.css";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  publishedTime?: string;
}

const {
  title,
  description = "Rafey Ahmad's personal website about software, learning, and the internet.",
  type = "website",
  publishedTime,
} = Astro.props;

const pageTitle = title ? `${title} | Rafey Ahmad` : "Rafey Ahmad";
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImage = await getImage({
  src: profileImg,
  width: 927,
  height: 486,
  fit: "cover",
  format: "jpeg",
});
const socialImageURL = new URL(socialImage.src, Astro.site ?? Astro.url.origin);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Rafey Ahmad" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content="Rafey Ahmad" />
    <meta property="og:image:width" content="927" />
    <meta property="og:image:height" content="486" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@rafeytwt" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content="Rafey Ahmad" />

    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-950">
    <div class="mx-auto flex min-h-screen max-w-prose flex-col px-4">
      <Header />
      <main class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>
    <MediaLightbox />
  </body>
</html>
